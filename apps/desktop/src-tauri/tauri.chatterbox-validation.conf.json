{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VoxLeaf-Chatterbox-Validation",
  "version": "0.1.0",
  "identifier": "com.voxleaf.desktop.chatterbox-validation",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "VoxLeaf Chatterbox Validation",
        "width": 960,
        "height": 720,
        "minWidth": 320,
        "minHeight": 480,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": false,
    "publisher": "VoxLeaf Project",
    "category": "Reference",
    "shortDescription": "Local-only Chatterbox acquisition validation build",
    "longDescription": "A separately identified unsigned VoxLeaf build for maintainer-operated validation of the optional Chatterbox download and removal lifecycle.",
    "icon": ["icons/icon.ico"],
    "resources": {
      "../../../LICENSE": "resources/notices/VOXLEAF-MIT.txt",
      "../../../docs/user/windows-release.md": "resources/docs/WINDOWS-RELEASE.md",
      "../../../services/tts/release/component-inventory-v1.json": "resources/release/component-inventory-v1.json",
      "../../../services/tts/release/core/dist/voxleaf-piper-core-v1/": "resources/tts/voxleaf-piper-core-v1/",
      "../../../services/tts/release/optional/chatterbox/THIRD-PARTY-NOTICES.md": "resources/release/optional/chatterbox/THIRD-PARTY-NOTICES.md",
      "../../../services/tts/release/optional/chatterbox/optional-package-manifest-v2.json": "resources/release/optional/chatterbox/optional-package-manifest-v2.json",
      "../../../services/tts/release/optional/chatterbox/optional-package-validation-overlay-v1.json": "resources/release/optional/chatterbox/optional-package-validation-overlay-v1.json",
      "../../../services/tts/release/optional/chatterbox/source-manifest-v2.json": "resources/release/optional/chatterbox/source-manifest-v2.json"
    },
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Spanish"],
        "displayLanguageSelector": true,
        "installerHooks": "windows/nsis-chatterbox-validation-hooks.nsh"
      }
    }
  }
}
