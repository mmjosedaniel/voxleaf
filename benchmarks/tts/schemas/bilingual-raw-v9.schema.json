{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:voxleaf:benchmark:tts-bilingual-raw:v9",
  "title": "VoxLeaf private bilingual measurement v9",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "candidateId",
    "authorityCommitSha",
    "executionCommitSha",
    "profileSha256",
    "corpusSha256",
    "candidateManifestSha256",
    "dependencyLockSha256",
    "status",
    "languagesEvaluated",
    "attempts",
    "cancellationTrials",
    "memory",
    "audits",
    "observations",
    "decision"
  ],
  "properties": {
    "schemaVersion": { "const": "tts-bilingual-raw-v9" },
    "candidateId": { "$ref": "#/$defs/candidate" },
    "authorityCommitSha": { "$ref": "#/$defs/commit" },
    "executionCommitSha": { "$ref": "#/$defs/commit" },
    "profileSha256": { "$ref": "#/$defs/sha256" },
    "corpusSha256": { "$ref": "#/$defs/sha256" },
    "candidateManifestSha256": { "$ref": "#/$defs/sha256" },
    "dependencyLockSha256": { "$ref": "#/$defs/sha256" },
    "status": {
      "enum": [
        "measured-awaiting-decision",
        "execution-blocked-awaiting-decision"
      ]
    },
    "languagesEvaluated": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": { "enum": ["es", "en"] }
    },
    "attempts": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "caseId",
          "language",
          "sampleCount",
          "sampleRateHz",
          "channels",
          "wallNanoseconds",
          "firstAudioNanoseconds",
          "status"
        ],
        "properties": {
          "caseId": { "$ref": "#/$defs/stableId" },
          "language": { "enum": ["es", "en"] },
          "sampleCount": { "type": "integer", "minimum": 0 },
          "sampleRateHz": { "const": 24000 },
          "channels": { "const": 1 },
          "wallNanoseconds": { "type": "integer", "minimum": 0 },
          "firstAudioNanoseconds": { "type": "integer", "minimum": 0 },
          "status": { "enum": ["complete", "failed"] }
        }
      }
    },
    "cancellationTrials": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "trialId",
          "language",
          "passed",
          "stopNanoseconds",
          "cleanupNanoseconds"
        ],
        "properties": {
          "trialId": { "$ref": "#/$defs/stableId" },
          "language": { "enum": ["es", "en"] },
          "passed": { "type": "boolean" },
          "stopNanoseconds": { "type": "integer", "minimum": 0 },
          "cleanupNanoseconds": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "memory": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["peakProcessTreeRamBytes", "peakDedicatedVramBytes"],
          "properties": {
            "peakProcessTreeRamBytes": { "type": "integer", "minimum": 0 },
            "peakDedicatedVramBytes": {
              "type": ["integer", "null"],
              "minimum": 0
            }
          }
        }
      ]
    },
    "audits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifacts",
        "offline",
        "networkIsolation",
        "privacy",
        "boundedRetention",
        "cleanup"
      ],
      "properties": {
        "artifacts": { "type": "boolean" },
        "offline": { "type": "boolean" },
        "networkIsolation": { "type": "boolean" },
        "privacy": { "type": "boolean" },
        "boundedRetention": { "type": "boolean" },
        "cleanup": { "type": "boolean" }
      }
    },
    "observations": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/stableId" }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": { "state": { "const": "pending-maintainer-decision" } }
    }
  },
  "$defs": {
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "stableId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"
    },
    "candidate": {
      "enum": [
        "qwen3-tts-1-7b-customvoice-cuda-bf16-serena-es-v9",
        "qwen3-tts-1-7b-customvoice-cuda-bf16-aiden-en-v9",
        "chatterbox-multilingual-v3-cuda-bf16-default-v2",
        "moss-tts-nano-100m-onnx-cpu-ava-v2"
      ]
    }
  }
}
