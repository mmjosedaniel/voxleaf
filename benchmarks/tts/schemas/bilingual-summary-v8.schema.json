{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:voxleaf:benchmark:tts-bilingual-summary:v8",
  "title": "VoxLeaf bilingual content-safe summary v8",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "candidateId",
    "evaluationStage",
    "authorityCommitSha",
    "executionCommitSha",
    "profileSha256",
    "corpusSha256",
    "candidateManifestSha256",
    "dependencyLockSha256",
    "status",
    "languagesEvaluated",
    "counts",
    "performanceByLanguage",
    "memory",
    "cancellation",
    "qualityByLanguage",
    "audits",
    "gates",
    "limitations"
  ],
  "properties": {
    "schemaVersion": {
      "const": "tts-bilingual-summary-v8"
    },
    "candidateId": {
      "$ref": "#/$defs/admittedCandidate"
    },
    "evaluationStage": {
      "enum": ["baseline", "existing-engine-control", "screen", "full-matrix"]
    },
    "authorityCommitSha": {
      "$ref": "#/$defs/commit"
    },
    "executionCommitSha": {
      "$ref": "#/$defs/commit"
    },
    "profileSha256": {
      "$ref": "#/$defs/sha256"
    },
    "corpusSha256": {
      "$ref": "#/$defs/sha256"
    },
    "candidateManifestSha256": {
      "$ref": "#/$defs/sha256"
    },
    "dependencyLockSha256": {
      "$ref": "#/$defs/sha256"
    },
    "status": {
      "enum": ["complete", "rejected", "failed", "invalid"]
    },
    "languagesEvaluated": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "enum": ["es", "en"]
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "firstAttempts",
        "completedGenerations",
        "failedGenerations",
        "cancellationTrials"
      ],
      "properties": {
        "firstAttempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 240
        },
        "completedGenerations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 240
        },
        "failedGenerations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 240
        },
        "cancellationTrials": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        }
      }
    },
    "performanceByLanguage": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "language",
          "firstAudioP95Seconds",
          "warmP95Rtf",
          "sustainedP95Rtf",
          "totalSustainedRtf",
          "failedFirstAttempts"
        ],
        "properties": {
          "language": {
            "enum": ["es", "en"]
          },
          "firstAudioP95Seconds": {
            "type": "number",
            "minimum": 0
          },
          "warmP95Rtf": {
            "type": "number",
            "minimum": 0
          },
          "sustainedP95Rtf": {
            "type": "number",
            "minimum": 0
          },
          "totalSustainedRtf": {
            "type": "number",
            "minimum": 0
          },
          "failedFirstAttempts": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "memory": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "peakProcessTreeRamBytes",
            "peakDedicatedVramBytes",
            "minimumAvailableSystemRamBytes"
          ],
          "properties": {
            "peakProcessTreeRamBytes": {
              "type": "integer",
              "minimum": 0
            },
            "peakDedicatedVramBytes": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "minimumAvailableSystemRamBytes": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "cancellation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requiredTrials",
        "passedTrials",
        "staleUnits",
        "processesRemaining"
      ],
      "properties": {
        "requiredTrials": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "passedTrials": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "staleUnits": {
          "type": "integer",
          "minimum": 0
        },
        "processesRemaining": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "qualityByLanguage": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "language",
              "evaluatorCount",
              "blindOrder",
              "overallMean",
              "intelligibilityMean",
              "naturalnessMean",
              "meaningChangingDefects",
              "wrongLanguageOutputs"
            ],
            "properties": {
              "language": {
                "enum": ["es", "en"]
              },
              "evaluatorCount": {
                "const": 1
              },
              "blindOrder": {
                "const": true
              },
              "overallMean": {
                "$ref": "#/$defs/score"
              },
              "intelligibilityMean": {
                "$ref": "#/$defs/score"
              },
              "naturalnessMean": {
                "$ref": "#/$defs/score"
              },
              "meaningChangingDefects": {
                "type": "integer",
                "minimum": 0
              },
              "wrongLanguageOutputs": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["language", "status"],
            "properties": {
              "language": {
                "enum": ["es", "en"]
              },
              "status": {
                "enum": ["not-admitted", "evaluator-unavailable"]
              }
            }
          }
        ]
      }
    },
    "audits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifacts",
        "offline",
        "networkIsolation",
        "privacy",
        "boundedRetention",
        "cleanup",
        "firstAttemptsOnly"
      ],
      "properties": {
        "artifacts": {
          "type": "boolean"
        },
        "offline": {
          "type": "boolean"
        },
        "networkIsolation": {
          "type": "boolean"
        },
        "privacy": {
          "type": "boolean"
        },
        "boundedRetention": {
          "type": "boolean"
        },
        "cleanup": {
          "type": "boolean"
        },
        "firstAttemptsOnly": {
          "type": "boolean"
        }
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "machine",
        "performance",
        "memory",
        "cancellation",
        "quality",
        "privacy",
        "cleanup",
        "overall"
      ],
      "properties": {
        "machine": {
          "$ref": "#/$defs/gate"
        },
        "performance": {
          "$ref": "#/$defs/gate"
        },
        "memory": {
          "$ref": "#/$defs/gate"
        },
        "cancellation": {
          "$ref": "#/$defs/gate"
        },
        "quality": {
          "$ref": "#/$defs/gate"
        },
        "privacy": {
          "$ref": "#/$defs/gate"
        },
        "cleanup": {
          "$ref": "#/$defs/gate"
        },
        "overall": {
          "$ref": "#/$defs/gate"
        }
      }
    },
    "limitations": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/stableId"
      }
    }
  },
  "$defs": {
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "stableId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"
    },
    "score": {
      "type": "number",
      "minimum": 1,
      "maximum": 5
    },
    "gate": {
      "enum": ["pass", "fail", "blocked", "not-admitted"]
    },
    "admittedCandidate": {
      "enum": [
        "piper-1-4-2-onnx-cpu-en-us-joe-medium-v1",
        "qwen3-tts-1-7b-customvoice-cuda-bf16-serena-es-v8",
        "qwen3-tts-1-7b-customvoice-cuda-bf16-aiden-en-v8",
        "chatterbox-multilingual-v3-cuda-bf16-default-v1",
        "moss-tts-nano-100m-onnx-cpu-ava-v1"
      ]
    }
  }
}
