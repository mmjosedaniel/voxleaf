{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voxleaf.local/schemas/tts/dual-worker-raw-v5.schema.json",
  "title": "VoxLeaf private dual-worker TTS raw result v5",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "profileVersion",
    "profileSha256",
    "corpusSha256",
    "authorityCommitSha",
    "executionCommitSha",
    "treeClean",
    "resultPurpose",
    "arm",
    "host",
    "preflight",
    "loads",
    "dispatches",
    "cancellationTrials",
    "memorySamples",
    "quality",
    "cleanup",
    "failureCodes"
  ],
  "properties": {
    "schemaVersion": {
      "const": "tts-dual-worker-raw-v5"
    },
    "profileVersion": {
      "const": "tts-dual-worker-profile-v5"
    },
    "profileSha256": {
      "$ref": "#/$defs/sha256"
    },
    "corpusSha256": {
      "$ref": "#/$defs/sha256"
    },
    "authorityCommitSha": {
      "$ref": "#/$defs/gitSha"
    },
    "executionCommitSha": {
      "$ref": "#/$defs/gitSha"
    },
    "treeClean": {
      "const": true
    },
    "resultPurpose": {
      "const": "official"
    },
    "arm": {
      "$ref": "#/$defs/arm"
    },
    "host": {
      "$ref": "#/$defs/host"
    },
    "preflight": {
      "$ref": "#/$defs/preflight"
    },
    "loads": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/load"
      }
    },
    "dispatches": {
      "type": "array",
      "minItems": 8,
      "maxItems": 40,
      "items": {
        "$ref": "#/$defs/dispatch"
      }
    },
    "cancellationTrials": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "$ref": "#/$defs/cancellation"
      }
    },
    "memorySamples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/memorySample"
      }
    },
    "quality": {
      "$ref": "#/$defs/privateQuality"
    },
    "cleanup": {
      "$ref": "#/$defs/cleanup"
    },
    "failureCodes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/failureCode"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "nonnegativeInteger": {
      "type": "integer",
      "minimum": 0
    },
    "positiveInteger": {
      "type": "integer",
      "minimum": 1
    },
    "nonnegativeNumber": {
      "type": "number",
      "minimum": 0
    },
    "arm": {
      "enum": ["cpu-solo", "gpu-solo", "concurrent"]
    },
    "workerRole": {
      "enum": ["gpu-primary", "cpu-support"]
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operatingSystem",
        "osVersion",
        "architecture",
        "pythonVersion",
        "cpuModel",
        "logicalProcessors",
        "totalRamBytes",
        "gpuModel",
        "totalVramBytes",
        "driverVersion"
      ],
      "properties": {
        "operatingSystem": {
          "const": "Windows"
        },
        "osVersion": {
          "const": "10.0.26200"
        },
        "architecture": {
          "const": "x86_64"
        },
        "pythonVersion": {
          "const": "3.12.10"
        },
        "cpuModel": {
          "const": "Intel Core Ultra 7 255HX"
        },
        "logicalProcessors": {
          "const": 20
        },
        "totalRamBytes": {
          "const": 33752997888
        },
        "gpuModel": {
          "const": "NVIDIA GeForce RTX 5060 Laptop GPU"
        },
        "totalVramBytes": {
          "const": 8546942976
        },
        "driverVersion": {
          "const": "577.05"
        }
      }
    },
    "preflight": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateInterpreterVerified",
        "authorityHashesVerified",
        "artifactHashesVerified",
        "offlineEnvironmentVerified",
        "localFilesOnlyVerified",
        "outboundFirewallBlocksVerified",
        "acPowerVerified",
        "sleepDisabled",
        "backgroundLoadAccepted",
        "thermalStateAccepted",
        "freeRamBytes",
        "systemCommitHeadroomBytes",
        "freeVramBytes",
        "gpuSharedMemoryBytes",
        "cpuCudaHidden"
      ],
      "properties": {
        "candidateInterpreterVerified": {
          "type": "boolean"
        },
        "authorityHashesVerified": {
          "type": "boolean"
        },
        "artifactHashesVerified": {
          "type": "boolean"
        },
        "offlineEnvironmentVerified": {
          "type": "boolean"
        },
        "localFilesOnlyVerified": {
          "type": "boolean"
        },
        "outboundFirewallBlocksVerified": {
          "type": "boolean"
        },
        "acPowerVerified": {
          "type": "boolean"
        },
        "sleepDisabled": {
          "type": "boolean"
        },
        "backgroundLoadAccepted": {
          "type": "boolean"
        },
        "thermalStateAccepted": {
          "type": "boolean"
        },
        "freeRamBytes": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "systemCommitHeadroomBytes": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "freeVramBytes": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "gpuSharedMemoryBytes": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "cpuCudaHidden": {
          "type": "boolean"
        }
      }
    },
    "load": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workerRole",
        "observationIndex",
        "durationSeconds",
        "status",
        "failureCode",
        "device",
        "dtype",
        "intraOpThreads",
        "interopThreads",
        "cudaAvailable",
        "cudaDeviceCount",
        "diskOrMetaParameters",
        "implicitFallback",
        "dedicatedGpuBytes",
        "sharedGpuBytes"
      ],
      "properties": {
        "workerRole": {
          "$ref": "#/$defs/workerRole"
        },
        "observationIndex": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "durationSeconds": {
          "$ref": "#/$defs/nonnegativeNumber"
        },
        "status": {
          "enum": ["completed", "failed", "timed-out"]
        },
        "failureCode": {
          "oneOf": [
            {
              "$ref": "#/$defs/failureCode"
            },
            {
              "type": "null"
            }
          ]
        },
        "device": {
          "enum": ["cuda:0", "cpu"]
        },
        "dtype": {
          "enum": ["bfloat16", "float32"]
        },
        "intraOpThreads": {
          "$ref": "#/$defs/positiveInteger"
        },
        "interopThreads": {
          "$ref": "#/$defs/positiveInteger"
        },
        "cudaAvailable": {
          "type": "boolean"
        },
        "cudaDeviceCount": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "diskOrMetaParameters": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "implicitFallback": {
          "type": "boolean"
        },
        "dedicatedGpuBytes": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "sharedGpuBytes": {
          "$ref": "#/$defs/nonnegativeInteger"
        }
      }
    },
    "dispatch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dispatchSequence",
        "occurrenceId",
        "unitId",
        "sourceSequence",
        "passIndex",
        "workerRole",
        "attempt",
        "acceptedNanoseconds",
        "completedNanoseconds",
        "status",
        "failureCode",
        "sampleCount",
        "sampleRateHz",
        "durationSeconds",
        "generationSeconds",
        "rtf",
        "publishedSequence",
        "headOfLineWaitSeconds"
      ],
      "properties": {
        "dispatchSequence": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "occurrenceId": {
          "type": "string",
          "pattern": "^v5-(cpu|gpu|concurrent)-p[0-9]{2}-es-v4-[a-z-]+$"
        },
        "unitId": {
          "enum": [
            "es-v4-arrival",
            "es-v4-dialogue",
            "es-v4-numbers",
            "es-v4-date-time",
            "es-v4-temperature",
            "es-v4-foreign-name",
            "es-v4-route",
            "es-v4-closing"
          ]
        },
        "sourceSequence": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "passIndex": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "workerRole": {
          "$ref": "#/$defs/workerRole"
        },
        "attempt": {
          "const": 1
        },
        "acceptedNanoseconds": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "completedNanoseconds": {
          "oneOf": [
            {
              "$ref": "#/$defs/nonnegativeInteger"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": ["completed", "failed", "timed-out", "cancelled", "stale"]
        },
        "failureCode": {
          "oneOf": [
            {
              "$ref": "#/$defs/failureCode"
            },
            {
              "type": "null"
            }
          ]
        },
        "sampleCount": {
          "oneOf": [
            {
              "$ref": "#/$defs/positiveInteger"
            },
            {
              "type": "null"
            }
          ]
        },
        "sampleRateHz": {
          "oneOf": [
            {
              "const": 24000
            },
            {
              "type": "null"
            }
          ]
        },
        "durationSeconds": {
          "oneOf": [
            {
              "$ref": "#/$defs/nonnegativeNumber"
            },
            {
              "type": "null"
            }
          ]
        },
        "generationSeconds": {
          "oneOf": [
            {
              "$ref": "#/$defs/nonnegativeNumber"
            },
            {
              "type": "null"
            }
          ]
        },
        "rtf": {
          "oneOf": [
            {
              "$ref": "#/$defs/nonnegativeNumber"
            },
            {
              "type": "null"
            }
          ]
        },
        "publishedSequence": {
          "oneOf": [
            {
              "$ref": "#/$defs/nonnegativeInteger"
            },
            {
              "type": "null"
            }
          ]
        },
        "headOfLineWaitSeconds": {
          "oneOf": [
            {
              "$ref": "#/$defs/nonnegativeNumber"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "cancellation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trialId",
        "passed",
        "identityInvalidationMilliseconds",
        "gpuWorkerTerminationMilliseconds",
        "cpuWorkerTerminationMilliseconds",
        "stalePublishedUnits",
        "stalePlayedUnits",
        "workerProcessesRemaining",
        "cleanupMilliseconds"
      ],
      "properties": {
        "trialId": {
          "enum": [
            "before-dispatch",
            "gpu-active",
            "cpu-active",
            "both-active",
            "complete-before-ordered-release",
            "queued-after-invalidation"
          ]
        },
        "passed": {
          "type": "boolean"
        },
        "identityInvalidationMilliseconds": {
          "$ref": "#/$defs/nonnegativeNumber"
        },
        "gpuWorkerTerminationMilliseconds": {
          "oneOf": [
            {
              "$ref": "#/$defs/nonnegativeNumber"
            },
            {
              "type": "null"
            }
          ]
        },
        "cpuWorkerTerminationMilliseconds": {
          "oneOf": [
            {
              "$ref": "#/$defs/nonnegativeNumber"
            },
            {
              "type": "null"
            }
          ]
        },
        "stalePublishedUnits": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "stalePlayedUnits": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "workerProcessesRemaining": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "cleanupMilliseconds": {
          "$ref": "#/$defs/nonnegativeNumber"
        }
      }
    },
    "memorySample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timestampNanoseconds",
        "systemAvailableRamBytes",
        "systemCommitUsedBytes",
        "systemCommitLimitBytes",
        "controllerRamBytes",
        "gpuWorkerRamBytes",
        "cpuWorkerRamBytes",
        "gpuWorkerDedicatedVramBytes",
        "gpuWorkerSharedGpuBytes",
        "cpuWorkerDedicatedVramBytes",
        "cpuWorkerSharedGpuBytes",
        "frameworkReservedVramBytes"
      ],
      "properties": {
        "timestampNanoseconds": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "systemAvailableRamBytes": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "systemCommitUsedBytes": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "systemCommitLimitBytes": {
          "$ref": "#/$defs/positiveInteger"
        },
        "controllerRamBytes": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "gpuWorkerRamBytes": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "cpuWorkerRamBytes": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "gpuWorkerDedicatedVramBytes": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "gpuWorkerSharedGpuBytes": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "cpuWorkerDedicatedVramBytes": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "cpuWorkerSharedGpuBytes": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "frameworkReservedVramBytes": {
          "$ref": "#/$defs/nonnegativeInteger"
        }
      }
    },
    "privateQuality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evaluatorCount", "observations"],
      "properties": {
        "status": {
          "enum": ["not-admitted", "pending-admitted-review", "complete"]
        },
        "evaluatorCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "observations": {
          "type": "array",
          "maxItems": 40,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "occurrenceId",
              "intelligibility",
              "numberAndSymbolNormalization",
              "joinBoundaries",
              "prosody",
              "accent",
              "meaningChangingDefects"
            ],
            "properties": {
              "occurrenceId": {
                "type": "string",
                "pattern": "^v5-concurrent-p[0-9]{2}-es-v4-[a-z-]+$"
              },
              "intelligibility": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              "numberAndSymbolNormalization": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              "joinBoundaries": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              "prosody": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              "accent": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              "meaningChangingDefects": {
                "$ref": "#/$defs/nonnegativeInteger"
              }
            }
          }
        }
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workerProcessesRemaining",
        "postCleanupTrackedRamBytes",
        "postCleanupGpuWorkerDedicatedVramBytes",
        "postCleanupGpuWorkerSharedGpuBytes",
        "postCleanupCpuWorkerDedicatedVramBytes",
        "postCleanupCpuWorkerSharedGpuBytes",
        "rawSessionRemoved",
        "generatedAudioRemoved",
        "scorecardRemoved",
        "sleepSettingRestored"
      ],
      "properties": {
        "workerProcessesRemaining": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "postCleanupTrackedRamBytes": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "postCleanupGpuWorkerDedicatedVramBytes": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "postCleanupGpuWorkerSharedGpuBytes": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "postCleanupCpuWorkerDedicatedVramBytes": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "postCleanupCpuWorkerSharedGpuBytes": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "rawSessionRemoved": {
          "type": "boolean"
        },
        "generatedAudioRemoved": {
          "type": "boolean"
        },
        "scorecardRemoved": {
          "type": "boolean"
        },
        "sleepSettingRestored": {
          "type": "boolean"
        }
      }
    },
    "failureCode": {
      "enum": [
        "artifact",
        "authority",
        "cancellation-failed",
        "cleanup-failed",
        "commit-headroom",
        "cpu-device-placement",
        "cpu-gpu-allocation",
        "duplicate-identity",
        "generation-failed",
        "generation-timeout",
        "gpu-shared-memory",
        "gpu-slowdown",
        "gpu-vram-safety",
        "input",
        "invalid-waveform",
        "load-failed",
        "load-timeout",
        "minimum-media",
        "offline",
        "order",
        "playback-limit",
        "process-crash",
        "ram-safety",
        "resource-limit",
        "stale-identity",
        "sustained-rtf",
        "unit-duration"
      ]
    }
  }
}
