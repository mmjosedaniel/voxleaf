{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:voxleaf:benchmark:tts-bilingual-full-summary:v12",
  "title": "VoxLeaf content-safe corrective Chatterbox full evaluation v12",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "candidateId",
    "authorityCommitSha",
    "executionCommitSha",
    "profileSha256",
    "corpusSha256",
    "candidateManifestSha256",
    "dependencyLockSha256",
    "status",
    "languagesEvaluated",
    "counts",
    "performanceByLanguage",
    "memory",
    "cancellation",
    "qualityByLanguage",
    "audits",
    "observations",
    "decision",
    "limitations"
  ],
  "properties": {
    "schemaVersion": { "const": "tts-bilingual-full-summary-v12" },
    "candidateId": {
      "const": "chatterbox-multilingual-v3-cuda-bf16-default-v4"
    },
    "authorityCommitSha": { "$ref": "#/$defs/commit" },
    "executionCommitSha": { "$ref": "#/$defs/commit" },
    "profileSha256": { "$ref": "#/$defs/sha256" },
    "corpusSha256": { "$ref": "#/$defs/sha256" },
    "candidateManifestSha256": { "$ref": "#/$defs/sha256" },
    "dependencyLockSha256": { "$ref": "#/$defs/sha256" },
    "status": {
      "enum": [
        "measured-awaiting-decision",
        "execution-blocked-awaiting-decision"
      ]
    },
    "languagesEvaluated": { "const": ["es", "en"] },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coldLoads",
        "warmAttempts",
        "sustainedAttempts",
        "failedAttempts",
        "cancellationTrials"
      ],
      "properties": {
        "coldLoads": { "type": "integer", "minimum": 0, "maximum": 5 },
        "warmAttempts": { "type": "integer", "minimum": 0, "maximum": 20 },
        "sustainedAttempts": { "type": "integer", "minimum": 0, "maximum": 30 },
        "failedAttempts": { "type": "integer", "minimum": 0, "maximum": 50 },
        "cancellationTrials": { "type": "integer", "minimum": 0, "maximum": 8 }
      }
    },
    "performanceByLanguage": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "language",
          "firstAudioP95Seconds",
          "warmP95Rtf",
          "sustainedP95Rtf",
          "totalSustainedRtf"
        ],
        "properties": {
          "language": { "enum": ["es", "en"] },
          "firstAudioP95Seconds": { "type": ["number", "null"], "minimum": 0 },
          "warmP95Rtf": { "type": ["number", "null"], "minimum": 0 },
          "sustainedP95Rtf": { "type": ["number", "null"], "minimum": 0 },
          "totalSustainedRtf": { "type": ["number", "null"], "minimum": 0 }
        }
      }
    },
    "memory": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "peakProcessTreeRamBytes",
            "peakDedicatedVramBytes",
            "minimumAvailableSystemRamBytes"
          ],
          "properties": {
            "peakProcessTreeRamBytes": { "type": "integer", "minimum": 0 },
            "peakDedicatedVramBytes": {
              "type": ["integer", "null"],
              "minimum": 0
            },
            "minimumAvailableSystemRamBytes": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      ]
    },
    "cancellation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requiredTrials",
        "passedTrials",
        "staleUnits",
        "processesRemaining"
      ],
      "properties": {
        "requiredTrials": { "const": 8 },
        "passedTrials": { "type": "integer", "minimum": 0, "maximum": 8 },
        "staleUnits": { "type": "integer", "minimum": 0 },
        "processesRemaining": { "type": "integer", "minimum": 0 }
      }
    },
    "qualityByLanguage": {
      "type": "array",
      "maxItems": 2,
      "items": { "$ref": "#/$defs/quality" }
    },
    "audits": { "$ref": "#/$defs/audits" },
    "observations": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/stableId" }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "rejectionRecorded"],
      "properties": {
        "state": { "const": "pending-maintainer-decision" },
        "rejectionRecorded": { "const": false }
      }
    },
    "limitations": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/stableId" }
    }
  },
  "$defs": {
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "stableId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "language",
        "status",
        "sampleCount",
        "dimensionMeans",
        "meaningChangingDefects",
        "wrongLanguageOutputs"
      ],
      "properties": {
        "language": { "enum": ["es", "en"] },
        "status": {
          "enum": ["pending-private-review", "reviewed-awaiting-decision"]
        },
        "sampleCount": { "type": "integer", "minimum": 0, "maximum": 5 },
        "dimensionMeans": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": [
            "intelligibility",
            "naturalness",
            "prosody",
            "pronunciation",
            "language-stability",
            "overall-usefulness"
          ],
          "properties": {
            "intelligibility": { "type": "number", "minimum": 1, "maximum": 5 },
            "naturalness": { "type": "number", "minimum": 1, "maximum": 5 },
            "prosody": { "type": "number", "minimum": 1, "maximum": 5 },
            "pronunciation": { "type": "number", "minimum": 1, "maximum": 5 },
            "language-stability": {
              "type": "number",
              "minimum": 1,
              "maximum": 5
            },
            "overall-usefulness": {
              "type": "number",
              "minimum": 1,
              "maximum": 5
            }
          }
        },
        "meaningChangingDefects": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 5
        },
        "wrongLanguageOutputs": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 5
        }
      }
    },
    "audits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifacts",
        "offline",
        "networkIsolation",
        "privacy",
        "boundedRetention",
        "cleanup"
      ],
      "properties": {
        "artifacts": { "type": "boolean" },
        "offline": { "type": "boolean" },
        "networkIsolation": { "type": "boolean" },
        "privacy": { "type": "boolean" },
        "boundedRetention": { "type": "boolean" },
        "cleanup": { "type": "boolean" }
      }
    }
  }
}
